<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: o splash do sistema usa o ícone adaptativo por padrão,
         que recorta o anel da "bola de cristal". Aqui fixamos a arte
         original completa como ícone do splash, sobre o fundo escuro do
         app — sem afetar o ícone da lista de apps nem as notificações. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#0B0A16</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
