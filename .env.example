# ====================================================================
# GRIMÓRIO DE BOLSO - Variáveis de Ambiente para Desenvolvimento
# ====================================================================
#
# Este arquivo contém exemplos das variáveis de ambiente necessárias
# para executar o app em modo de desenvolvimento.
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env (que está no .gitignore)
# 2. Preencha as chaves com seus valores reais do RevenueCat
# 3. Execute o app com: flutter run --dart-define-from-file=.env
#
# ⚠️  NUNCA commite o arquivo .env com suas chaves reais!
# ====================================================================

# RevenueCat API Keys
# Obtenha em: https://app.revenuecat.com/ → Project Settings → API Keys
REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxx
REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxx

# Outras configurações que podem ser adicionadas no futuro:
# GROQ_API_KEY=your_groq_api_key_here
# PROKERALA_CLIENT_ID=your_prokerala_client_id
# PROKERALA_CLIENT_SECRET=your_prokerala_client_secret
